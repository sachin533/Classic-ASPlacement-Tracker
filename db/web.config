<?xml version="1.0" encoding="UTF-8"?>
<!--
  Placement Tracker - db\web.config
  Removes every handler for this folder so that schema.sql / seed.sql /
  verify.sql can never be downloaded or executed through the web server.
  ASP includes (#include) are resolved by the ASP engine before handler
  mapping, so this does not affect anything the application needs.
-->
<configuration>
  <system.webServer>
    <handlers>
      <clear />
    </handlers>
  </system.webServer>
</configuration>
