<?xml version="1.0" encoding="UTF-8"?>
<!--
  Placement Tracker - inc\web.config
  Removes every handler for this folder so that inc\db.asp (which contains the
  connection string) and the other includes can never be requested directly.
  ASP #include directives are resolved by the ASP engine before handler
  mapping, so includes continue to work normally.
-->
<configuration>
  <system.webServer>
    <handlers>
      <clear />
    </handlers>
  </system.webServer>
</configuration>
