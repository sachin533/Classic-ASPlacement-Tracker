<?xml version="1.0" encoding="UTF-8"?>
<!--
  Placement Tracker - web.config
  Works on IIS 7+ and on IIS Express.

    * default.asp is the default document
    * /inc, /db, /tests and /iisexpress are locked down here and again by the
      web.config files inside those folders
    * customHeaders removes the X-Powered-By banner
    * httpErrors + rewrite give the site a real 404 page (see the comments on
      each block below)
-->
<configuration>

  <system.webServer>

    <directoryBrowse enabled="false" />

    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="default.asp" />
      </files>
    </defaultDocument>

    <!--
      Error handling, in two halves.

      1. existingResponse="PassThrough" - IIS replaces the entity body of any
         4xx/5xx response with its own built-in error file unless this is set,
         which is why every FailPage() response would otherwise come back
         empty.  PassThrough lets Classic ASP keep the page it rendered.

      2. The <rewrite> rules below - with PassThrough, IIS no longer maps its
         own 404 to a page, so a request for a URL that simply does not exist
         would have nothing to show.  The rules rewrite missing URLs (and
         anything under the protected folders) to /404.asp, which is an
         ordinary Classic ASP request: it renders our page and sets 404.
    -->
    <httpErrors errorMode="Custom" existingResponse="PassThrough" />

    <!--
      NOTE: {REQUEST_FILENAME} + matchType="IsFile" is deliberately NOT used
      here.  The physical path of this site contains a '#' character, which
      breaks the rewrite module's file-exists probe - it reports existing
      files as missing, so every request would be answered with a 404.  The
      rules below therefore name the pages and asset extensions that do
      exist.  On a site installed at a path without '#', the usual
      "IsFile / IsDirectory negate=true" rule can replace the second rule.
    -->
    <rewrite>
      <rules>

        <!-- Protected folders must never be served and must not leak the
             fact that they exist: they are answered by the 404 page. -->
        <rule name="Protected folders -> 404.asp" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{UNENCODED_URL}" pattern="^/(inc|db|tests|iisexpress)(/|$)" />
          </conditions>
          <action type="Rewrite" url="/404.asp" />
        </rule>

        <!-- Anything that is not one of the six pages and not a static
             asset is a missing URL -> 404.asp. -->
        <rule name="Missing URL -> 404.asp" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{UNENCODED_URL}" pattern="^/(\?.*)?$" negate="true" />
            <add input="{UNENCODED_URL}" pattern="^/(default|new|view|edit|delete|404)\.asp" negate="true" />
            <add input="{UNENCODED_URL}" pattern="\.(css|js|ico|png|jpg|jpeg|gif|svg|txt)(\?|$)" negate="true" />
          </conditions>
          <action type="Rewrite" url="/404.asp" />
        </rule>

      </rules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>

  <!-- ==================== internal folders ============================== -->
  <location path="inc">
    <system.webServer>
      <handlers>
        <clear />
      </handlers>
    </system.webServer>
  </location>

  <location path="db">
    <system.webServer>
      <handlers>
        <clear />
      </handlers>
    </system.webServer>
  </location>

  <location path="tests">
    <system.webServer>
      <handlers>
        <clear />
      </handlers>
    </system.webServer>
  </location>

  <location path="iisexpress">
    <system.webServer>
      <handlers>
        <clear />
      </handlers>
    </system.webServer>
  </location>

</configuration>



